# Copy this file to .env and fill in real values. .env is never committed.
APP_VERSION=dev

# PostgreSQL runs on the host; containers reach it via host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me

# Redis runs as a Compose service; reached by its service name
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me