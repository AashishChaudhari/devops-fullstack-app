// 1. Discover running containers through the Docker API
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Rules that turn Docker metadata into readable labels
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Docker Compose containers
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  // Docker Swarm containers: "devops-app_backend" becomes service="backend"
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = "[^_]+_(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    regex         = "(.+)"
    target_label  = "project"
  }
}

// 3. Read each container's stdout/stderr and apply the labels
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

// 4. Find the Nginx log files from the host
local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/devops.*.log",
    job      = "nginx",
    host     = "devops-server",
  }]
}

// 5. Read (tail) those files
loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.local.receiver]
}

// 6. Send everything to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}